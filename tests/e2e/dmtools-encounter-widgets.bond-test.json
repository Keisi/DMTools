{
  "name": "DMTools encounter widgets (quick encounter, bulk-add Qty, roll-unset, export recap, inline delete)",
  "baseUrl": "https://keisi.github.io/DMTools/",
  "description": "Browser coverage for the EncounterView / CampaignDetail widgets the smoke suite never reaches. Self-cleaning, UI-driven: logs in as the seed DM, creates a ZZ-BONDTEST campaign, makes a quick (no-session) encounter, bulk-adds an NPC with Qty=3, rolls initiative for the unset combatants, exports the session recap, then deletes the campaign via its inline two-click confirm (which is both the delete-confirm test AND the fixture cleanup). Navigates by clicking in-app nav (client-side routing) to avoid the GitHub Pages 404.html status. Asserts 0 console errors throughout. The committed copy keeps the <SEED_PASSWORD> placeholder; substitute it into a local copy before running (see README).",
  "steps": [
    { "action": "open", "url": "https://keisi.github.io/DMTools/login", "waitUntil": "networkidle" },
    { "action": "assertUrl", "contains": "/login" },
    { "action": "assertSelector", "selector": "input[type=password]" },
    { "action": "assertNoErrors" },
    { "action": "fill", "selector": "input:nth-of-type(1)", "value": "dungeonmaster" },
    { "action": "fill", "selector": "input[type=password]", "value": "<SEED_PASSWORD>" },
    { "action": "assertValue", "selector": "input:nth-of-type(1)", "equals": "dungeonmaster" },
    { "action": "click", "selector": "button[type=submit]" },
    { "action": "waitUrl", "contains": "/vault" },
    { "action": "assertText", "text": "The Vault" },
    { "action": "assertNoErrors" },

    { "action": "click", "selector": "a[href=\"/DMTools/campaigns\"]" },
    { "action": "waitUrl", "contains": "/campaigns" },
    { "action": "assertSelector", "selector": ".campaigns__head" },
    { "action": "assertNoErrors" },

    { "action": "click", "selector": ".campaigns__head button.btn--primary" },
    { "action": "assertSelector", "selector": "form.campaigns__create" },
    { "action": "fill", "selector": "input[placeholder=\"Campaign name\"]", "value": "ZZ-BONDTEST widgets" },
    { "action": "click", "selector": "form.campaigns__create button[type=submit]" },
    { "action": "waitUrl", "contains": "/campaigns/" },
    { "action": "assertText", "text": "ZZ-BONDTEST widgets" },
    { "action": "assertSelector", "selector": "form.camp__enc-form" },
    { "action": "assertNoErrors" },

    { "action": "assertSelector", "selector": "select.camp__enc-session-sel" },
    { "action": "assertEval", "expression": "document.querySelector('select.camp__enc-session-sel').value === ''" },
    { "action": "fill", "selector": "form.camp__enc-form input[placeholder=\"Encounter name\"]", "value": "ZZ Quick Skirmish" },
    { "action": "click", "selector": "form.camp__enc-form button[type=submit]" },
    { "action": "waitUrl", "contains": "/encounters/" },
    { "action": "assertText", "text": "ZZ Quick Skirmish" },
    { "action": "assertSelector", "selector": ".enc__subsection--enemy .enc__add-form" },
    { "action": "assertNoErrors" },

    { "action": "fill", "selector": ".enc__subsection--enemy .enc__add-field--name input", "value": "Goblin" },
    { "action": "fill", "selector": ".enc__subsection--enemy .enc__add-form .enc__add-field:nth-of-type(2) input", "value": "7" },
    { "action": "fill", "selector": ".enc__subsection--enemy .enc__add-form .enc__add-field:nth-of-type(3) input", "value": "15" },
    { "action": "fill", "selector": ".enc__subsection--enemy .enc__add-form .enc__add-field:nth-of-type(4) input", "value": "3" },
    { "action": "assertValue", "selector": ".enc__subsection--enemy .enc__add-form .enc__add-field:nth-of-type(4) input", "equals": "3" },
    { "action": "click", "selector": ".enc__subsection--enemy .enc__add-form button[type=submit]" },
    { "action": "assertText", "text": "Goblin 1" },
    { "action": "assertText", "text": "Goblin 2" },
    { "action": "assertText", "text": "Goblin 3" },
    { "action": "assertEval", "expression": "document.querySelectorAll('.enc__subsection--enemy .enc__comb-name').length === 3" },
    { "action": "assertNoErrors" },

    { "action": "assertEval", "expression": "document.querySelectorAll('.enc__init-inp').length === 3 && Array.from(document.querySelectorAll('.enc__init-inp')).every(i => i.value === '')" },
    { "action": "click", "selector": "button:has-text(\"Roll unset\")" },
    { "action": "assertEval", "expression": "document.querySelectorAll('.enc__init-inp').length === 3 && Array.from(document.querySelectorAll('.enc__init-inp')).every(i => i.value !== '')" },
    { "action": "assertNoErrors" },
    { "action": "screenshot", "path": "dmtools-encounter-goblins-rolled.png" },

    { "action": "click", "selector": "a.enc__back" },
    { "action": "assertText", "text": "ZZ-BONDTEST widgets" },
    { "action": "assertSelector", "selector": "form.camp__enc-form" },
    { "action": "assertNoErrors" },
    { "action": "click", "selector": "button:has-text(\"Export recap\")" },
    { "action": "assertText", "text": "Recap exported." },
    { "action": "assertNoErrors" },

    { "action": "click", "selector": "button.camp__delete" },
    { "action": "assertText", "text": "Delete campaign? This cannot be undone." },
    { "action": "assertSelector", "selector": "button.enc__end-confirm-yes" },
    { "action": "click", "selector": "button.enc__end-confirm-yes" },
    { "action": "assertSelector", "selector": ".campaigns__head" },
    { "action": "assertNotText", "text": "ZZ-BONDTEST widgets" },
    { "action": "assertNoErrors" }
  ]
}
